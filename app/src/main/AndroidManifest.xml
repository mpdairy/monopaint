<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".ProbeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PaintActivity" android:exported="true" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Keep existing launcher shortcuts working across the source-package rename. -->
        <activity-alias android:name="dev.tilesmile.supernote.PaintActivity"
            android:targetActivity=".PaintActivity" android:exported="true" />
    </application>
</manifest>
